          "rawQuery": true,
          "rawSql": "WITH latest_window AS (\n  SELECT \n    route_id,\n    MAX(window_start) AS max_window\n  FROM kpi_headway_adherence\n  WHERE window_start >= NOW() - INTERVAL '3 hours'\n  GROUP BY route_id\n),\nlatest AS (\n  SELECT \n    h.route_id,\n    AVG(h.adherence_ratio) AS adherence_ratio\n  FROM kpi_headway_adherence h\n  INNER JOIN latest_window lw ON h.route_id = lw.route_id AND h.window_start = lw.max_window\n  GROUP BY h.route_id\n)\nSELECT \n  route_id AS metric,\n  adherence_ratio AS value\nFROM latest\nORDER BY route_id",
          "refId": "A",
